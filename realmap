# -*- coding: utf-8 -*-

import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from matplotlib.patches import Ellipse
import cartopy.crs as ccrs
import cartopy.feature as cfeature
from cartopy.mpl.ticker import LongitudeFormatter, LatitudeFormatter


# ============================================================
# 1. 文件路径
# ============================================================

excel_file = r"D:\下载\JRA55_西脊点_41-49候_20年平均处理.xlsx"
sheet_name = "标准三阶段_宽表"

save_dir = r"E:\data\41-49_wrp_maps"
os.makedirs(save_dir, exist_ok=True)

save_path = os.path.join(save_dir, "WRP_41-49_3period_map.png")


# ============================================================
# 2. 读取 Excel 数据
# ============================================================

df = pd.read_excel(excel_file, sheet_name=sheet_name)

print("读取数据成功，列名如下：")
print(df.columns.tolist())

# 只保留 41-49 候（一般表里本来就是41-49，这里再保险筛一次）
df = df[(df["pentad"] >= 41) & (df["pentad"] <= 49)].copy()
df = df.sort_values("pentad")

# 三个阶段的数据
periods = [
    ("1961–1980", "mean_lon_1961-1980", "mean_lat_1961-1980", "#4D4D4D"),
    ("1981–2000", "mean_lon_1981-2000", "mean_lat_1981-2000", "#0072B2"),
    ("2001–2020", "mean_lon_2001-2020", "mean_lat_2001-2020", "#D55E00"),
]

pentad_labels = df["pentad"].astype(str).tolist()


# ============================================================
# 3. 地图范围
#    按你这批41-49候数据来定，不要太大
# ============================================================

all_lon = []
all_lat = []

for _, lon_col, lat_col, _ in periods:
    all_lon.extend(df[lon_col].values.tolist())
    all_lat.extend(df[lat_col].values.tolist())

lon_min = max(100, np.floor(min(all_lon)) - 5)
lon_max = min(140, np.ceil(max(all_lon)) + 5)
lat_min = max(20, np.floor(min(all_lat)) - 4)
lat_max = min(40, np.ceil(max(all_lat)) + 4)

print(f"地图范围：{lon_min}–{lon_max}°E, {lat_min}–{lat_max}°N")


# ============================================================
# 4. 绘图风格
# ============================================================

plt.rcParams.update({
    "font.family": "Arial",
    "font.size": 10,
    "axes.unicode_minus": False
})

proj = ccrs.PlateCarree()
fig, axes = plt.subplots(
    1, 3,
    figsize=(18, 6),
    subplot_kw={"projection": proj},
    dpi=300
)

# 如果只有一个子图，转成列表
if not isinstance(axes, np.ndarray):
    axes = [axes]


# ============================================================
# 5. 逐个阶段画图
# ============================================================

for i, (ax, (title, lon_col, lat_col, color)) in enumerate(zip(axes, periods)):
    lon_data = df[lon_col].values
    lat_data = df[lat_col].values

    # ---------------- 地图范围
    ax.set_extent([lon_min, lon_max, lat_min, lat_max], crs=proj)

    # ---------------- 底图要素
    ax.add_feature(cfeature.COASTLINE.with_scale("50m"), linewidth=0.9, color="#222222")
    ax.add_feature(cfeature.BORDERS.with_scale("50m"), linewidth=0.7, linestyle=":", color="#666666")
    ax.add_feature(cfeature.LAND, color="#f8f8f8", alpha=0.95)
    ax.add_feature(cfeature.OCEAN, color="#eaf7ff", alpha=0.9)
    ax.add_feature(cfeature.RIVERS.with_scale("50m"), linewidth=0.4, color="#87CEEB")

    # ---------------- 椭圆阴影（大体圈出西脊点位置）
    # 用均值作为中心，标准差控制椭圆大小，再略放大一点
    center_lon = np.mean(lon_data)
    center_lat = np.mean(lat_data)

    std_lon = np.std(lon_data, ddof=1) if len(lon_data) > 1 else 1.0
    std_lat = np.std(lat_data, ddof=1) if len(lat_data) > 1 else 1.0

    ellipse_width = max(std_lon * 4.5, 4.5)   # 经向宽度
    ellipse_height = max(std_lat * 4.5, 2.5)  # 纬向高度

    ellipse = Ellipse(
        (center_lon, center_lat),
        width=ellipse_width,
        height=ellipse_height,
        angle=0,
        facecolor=color,
        edgecolor="none",
        alpha=0.16,
        transform=proj,
        zorder=1
    )
    ax.add_patch(ellipse)

    # ---------------- 连接线
    ax.plot(
        lon_data, lat_data,
        color=color,
        linewidth=2.2,
        linestyle="-",
        transform=proj,
        zorder=3
    )

    # ---------------- 数据点
    ax.scatter(
        lon_data, lat_data,
        color=color,
        s=60,
        alpha=1.0,
        edgecolors="black",
        linewidth=0.8,
        transform=proj,
        zorder=4
    )

    # ---------------- 候数标号
    for lon, lat, label in zip(lon_data, lat_data, pentad_labels):
        ax.text(
            lon,
            lat - 0.28,
            label,
            fontsize=8.5,
            fontweight="bold",
            ha="center",
            va="top",
            color="black",
            bbox=dict(
                boxstyle="round,pad=0.15",
                facecolor="white",
                alpha=0.88,
                edgecolor="none"
            ),
            transform=proj,
            zorder=5
        )

    # ---------------- 坐标轴刻度
    xticks = np.arange(np.floor(lon_min / 5) * 5, lon_max + 1, 5)
    yticks = np.arange(np.floor(lat_min / 2) * 2, lat_max + 1, 2)

    ax.set_xticks(xticks, crs=proj)
    ax.set_yticks(yticks, crs=proj)

    lon_formatter = LongitudeFormatter(zero_direction_label=True)
    lat_formatter = LatitudeFormatter()
    ax.xaxis.set_major_formatter(lon_formatter)
    ax.yaxis.set_major_formatter(lat_formatter)

    ax.gridlines(
        draw_labels=False,
        linestyle="--",
        alpha=0.6,
        linewidth=0.6,
        color="#999999"
    )

    # ---------------- 标题
    ax.set_title(
        title,
        fontsize=13,
        fontweight="bold",
        pad=12,
        color="#333333"
    )

    # ---------------- 左上角子图编号
    ax.text(
        0.02, 0.98,
        f"({chr(97+i)})",
        transform=ax.transAxes,
        ha="left",
        va="top",
        fontsize=12,
        fontweight="bold",
        color="black"
    )




# ============================================================
# 6. 总标题
# ============================================================

fig.suptitle(
    "Mean positions of the western ridge point during pentads 41–49",
    fontsize=15,
    fontweight="bold",
    y=0.98
)

plt.tight_layout(rect=[0, 0, 1, 0.95])

# 保存
plt.savefig(
    save_path,
    dpi=300,
    bbox_inches="tight",
    facecolor="white",
    edgecolor="none"
)

plt.show()

print(f"图片已保存至：{save_path}")
